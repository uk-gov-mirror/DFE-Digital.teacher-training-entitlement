<% content_for :before_content do %>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: previous_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: form, url: form_path, scope: :form, method: :patch do |f| %>
      <%= f.govuk_error_summary %>

      <% content_for :title do %>
        <%= form.errors.present? ? "Form invalid: " : nil %>
        <%= form.class.name.split('::').last.titleize %>
      <% end %>


      <% form.questions.each do |question| %>
        <%=
          render(
            "registration_wizard/shared/questions/#{question.type}",
            form: f,
            question: question,
          )
        %>
      <% end %>

      <%= yield :before_submit %>

      <%= f.govuk_submit %>
    <% end %>
  </div>
</div>
