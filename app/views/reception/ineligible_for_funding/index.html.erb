<% content_for :title do %>
  <%= t("helpers.title.registration_wizard.ineligible_for_funding") %>
<% end %>

<% content_for :before_content do %>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: reception_start_index_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
      <%= render "registration_wizard/ineligible_for_funding/#{ineligible_template}", course: current_registration.course, lead_provider: current_registration.lead_provider&.name %>

  <%= govuk_button_link_to "Continue", reception_funding_your_course_index_path %>

  </div>
</div>

<% if Rails.env.staging? || Rails.env.development? %>
  "<%= current_registration.funding_eligiblity_status_code %>"
  <br />
<% end  %>
