<% content_for :before_content do %>
  <% href = current_registration.works_in_childcare? ? reception_kind_of_nursery_index_path : reception_work_setting_index_path%>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href:) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_choose_school_index_path do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <%= render 'registration_wizard/shared/questions/auto_complete_institution', form: f, question: @form.question %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>

<%= govuk_details(summary_text: "If you cannot find your workplace") do %>
  <p>You can:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>use any combination of postcode, workplace name, URN or street name</li>
    <li><%= external_link_to "check your workplace details", :gias_establishment_search, new_tab: true %> – including spelling</li>
  </ul>

<% end %>
