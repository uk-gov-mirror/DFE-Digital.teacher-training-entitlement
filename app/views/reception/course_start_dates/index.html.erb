<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl"><%= t("helpers.title.registration_wizard.course_start_date", date: application_course_start_date) %></h1>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <p class="govuk-body govuk-!-margin-bottom-4">
      <%= t("helpers.hint.registration_wizard.course_start_date_one") %>
    </p>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <p class="govuk-body govuk-!-margin-bottom-4">
      <%= t("helpers.hint.registration_wizard.course_start_date_two") %>
    </p>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <p class="govuk-body govuk-!-margin-bottom-4">
      <%= t("helpers.hint.registration_wizard.course_start_date_three", date: application_course_start_date) %>
    </p>
  </div>
</div>


<% content_for :before_content do %>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: reception_course_start_dates_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_course_start_dates_path do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <%= f.govuk_radio_buttons_fieldset(:course_start_date, **{ legend: { text: "Do you want to start a course in #{application_course_start_date}?", tag: "h2", size: "m" }}) do %>
        <%= f.govuk_radio_button(:course_start_date, 'yes', label: { text: I18n.t("helpers.label.registration_wizard.course_start_date_options.yes") }, link_errors: true, hint: { text: I18n.t("helpers.hint.registration_wizard.course_start_date_hint")}) %>
        <%= f.govuk_radio_button(:course_start_date, 'no', label: { text: I18n.t("helpers.label.registration_wizard.course_start_date_options.no") }) %>
      <% end %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>