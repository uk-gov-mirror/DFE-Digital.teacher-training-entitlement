<% content_for :before_content do %>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: reception_teacher_catchment_index_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_work_setting_index_path do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <% legend = { text: I18n.t("helpers.legend.registration_wizard.work_setting"), tag: "h1", size: "xl" } %>
      <%= f.govuk_radio_buttons_fieldset(:work_setting, **{ legend:, hint: { text: I18n.t("helpers.hint.registration_wizard.work_setting")} }) do %>
        <% @form.work_settings_options.each do |work_setting| %>
          <% hint = { text: I18n.t("helpers.hint.registration_wizard.work_setting_options.#{work_setting}_html").html_safe } %>
          <% label = { size: "s", text: I18n.t("helpers.label.registration_wizard.work_setting_options.#{work_setting}") } %>
          <%= f.govuk_radio_button(:work_setting, work_setting, hint:, label:) %>
        <% end %>
      <% end %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>