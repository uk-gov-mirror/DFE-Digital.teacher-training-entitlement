<%= render "reception_registrations/backlink", step: @step %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_registration_path(@step.name), method: :patch do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>

      <%= f.govuk_check_boxes_fieldset(:can_share_choices, multiple: false, legend: { text: I18n.t("helpers.legend.registration_wizard.can_share_choices") }) do %>
        <% I18n.t("helpers.hint.registration_wizard.can_share_choices").each do |line| %>
          <p class="govuk-body"><%= line.html_safe %></p>
        <% end %>
        <%= f.govuk_check_box :can_share_choices, "1", "0", multiple: false, required: true, label: { text: I18n.t("helpers.label.registration_wizard.can_share_choices_options.1") } %>
      <% end  %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>