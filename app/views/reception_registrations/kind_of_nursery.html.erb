<%= render "reception_registrations/backlink", step: @step %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_registration_path(@step.name), method: :patch do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <% legend = { text: I18n.t("helpers.legend.registration_wizard.kind_of_nursery"), tag: "h1", size: "xl" } %>
      <%= f.govuk_radio_buttons_fieldset(:kind_of_nursery, **{ legend: }) do %>
        <% @form.options.each do |option| %>
          <%= f.govuk_radio_button(:kind_of_nursery, option, label: { text: I18n.t("helpers.label.registration_wizard.kind_of_nursery_options.#{option}") }) %>
        <% end %>
      <% end %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>