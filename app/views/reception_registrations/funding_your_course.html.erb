<% content_for :title do %>
  <%= t("helpers.title.registration_wizard.funding_your_course") %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_registration_path(@step.name), method: :patch do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <% legend = { } %>
      <%= f.govuk_radio_buttons_fieldset(:funding, **{ legend: }) do %>
        <% @form.options.each do |option| %>
          <%= f.govuk_radio_button(:funding, option, label: { text: I18n.t("helpers.label.registration_wizard.funding_options.#{option}") }) %>
        <% end %>
      <% end %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>