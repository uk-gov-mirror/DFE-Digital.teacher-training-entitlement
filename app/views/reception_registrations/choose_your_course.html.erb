<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl"><%= t("helpers.title.registration_wizard.choose_your_course") %></h1>
  </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h3 class="govuk-heading-m"><%= @form.course.name %></h3>
        <h4 class="govuk-heading-s"><%= @form.course.description %></h4>
        <p class="govuk-body govuk-!-margin-bottom-7"> <%= t("helpers.hint.registration_wizard.choose_your_course", link: "<a href=''>learn more about the DfE CPD offering</a>").html_safe %> </p>
    </div>
</div>

<%= render "reception_registrations/backlink", step: @step %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, scope: :form, url: reception_registration_path(@step.name), method: :patch do |f| %>
      <%= render "reception/form_errors", f:, form: @form %>
      <%= f.hidden_field :course_identifier, value: @form.course.identifier %>
      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>