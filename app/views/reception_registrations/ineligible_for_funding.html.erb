<% content_for :title do %>
  <%= t("helpers.title.registration_wizard.ineligible_for_funding") %>
<% end %>

<%= render "reception_registrations/backlink", step: @step %>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
      <%= render "registration_wizard/ineligible_for_funding/#{current_registration.inelegible_for_funding_type}", course: current_registration.course, lead_provider: current_registration.lead_provider&.name %>

  <%= govuk_button_link_to "Continue", reception_registration_path(@step.next_step) %>

  </div>
</div>

<% if Rails.env.staging? || Rails.env.development? %>
  <p class="govuk-body">
    Ineligible type: "<%= current_registration.inelegible_for_funding_type %>"
    <br />
    <i>Note: this will not show in production</i>
  </p>
<% end  %>
